# Generated environments and caches
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.vite/
**/dist/

# Local configuration and secrets
**/.env
**/.env.*
!**/.env.example

# Experiment artifacts: keep metadata/results summaries, not bulky raw output
**/data/
**/datasets/
**/outputs/
**/runs/
**/logs/
**/checkpoints/
**/wandb/

# Editor and OS files
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db

# Recoverable metadata from repositories that were flattened into this repo
.nested-git-backup/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
paper/build.log
paper/main.log
paper/main.pdf
